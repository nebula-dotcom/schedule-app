<?xml version="1.0" encoding="utf-8"?>
<!-- Tema splash sistem per tema aplikasi; dipilih lewat SplashScreen.setSplashScreenTheme (Android 13+) untuk peluncuran berikutnya -->
<resources>
    <style name="JadwalSplashDark" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#121212</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
    <style name="JadwalSplashLight" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#F6F8FC</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
</resources>
