<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: splash sistem berlatar #F6F8FC dan TANPA ikon/logo (ikon transparan). Ganti #F6F8FC untuk warna lain, mis. #FFFFFF;
     hapus baris windowSplashScreenAnimatedIcon kalau ingin ikon aplikasi tampil di splash. -->
<resources>
    <style name="JadwalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">#F6F8FC</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowSplashScreenBackground">#F6F8FC</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
</resources>
